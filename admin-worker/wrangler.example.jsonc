{
  "name": "avepho-admin",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_ORIGIN": "https://avepho-admin.REPLACE.workers.dev",
    "GITHUB_CLIENT_ID": "REPLACE",
    "GITHUB_INSTALLATION_ID": "REPLACE"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avepho-admin",
      "database_id": "REPLACE"
    }
  ]
}
